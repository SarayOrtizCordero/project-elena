# ── Supabase (sin estas dos variables la app funciona en modo DEMO con datos locales) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (NUNCA con prefijo NEXT_PUBLIC_). Necesaria para leer suscripciones push de otros usuarios.
SUPABASE_SERVICE_ROLE_KEY=

# ── Web Push (VAPID). Genéralas una vez: npx web-push generate-vapid-keys ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:elena@tu-dominio.com
